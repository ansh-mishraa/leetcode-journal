# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-a-32-char-secret-here
BETTER_AUTH_URL=http://localhost:3000

# Database (Neon)
# Pooled connection for the app (ends with -pooler)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/leetcode_journal?sslmode=require&connect_timeout=15
# Direct connection for migrations
DIRECT_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/leetcode_journal?sslmode=require

# OAuth — Google + GitHub
# Create credentials, then set NEXT_PUBLIC_* so the buttons appear.
# Callback (local):  http://localhost:3000/api/auth/callback/google
# Callback (prod):   https://YOUR_DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH=true

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_GITHUB_AUTH=true

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Trigger.dev
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=

# Optional GitHub token for higher API rate limits when syncing public profiles
GITHUB_TOKEN=

# Groq (free tier) — Recall Engine AI coaching
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
